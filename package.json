{
  "name": "iphone-ding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch src/adapters/node-server.ts' 'vite --host 0.0.0.0'",
    "monitor": "tsx src/adapters/node-monitor.ts",
    "build": "vite build && esbuild src/adapters/node-server.ts src/adapters/node-monitor.ts scripts/data.ts scripts/probe.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/src/adapters/node-server.js",
    "start:monitor": "node dist/server/src/adapters/node-monitor.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf:dev": "npm run build && wrangler dev",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "data": "tsx scripts/data.ts",
    "probe": "tsx scripts/probe.ts",
    "format": "prettier --write src web tests scripts *.ts *.json *.jsonc *.yaml *.md .github/workflows/*.yml",
    "format:check": "prettier --check src web tests scripts *.ts *.json *.jsonc *.yaml *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
