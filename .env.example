# 至少 12 位；请替换，不要使用示例密码。
ADMIN_PASSWORD=
# 生成：openssl rand -hex 32
SESSION_SECRET=
# VPS HTTPS 域名，不包含 https://
DOMAIN=iphone-ding.example.com
# 公网访问地址（协议、域名和可选端口）；HTTPS 部署默认使用 https://${DOMAIN}
# 非 Compose 反向代理部署可显式设置，例如 https://iphone.phper.dev
PUBLIC_ORIGIN=
# 本地开发设为 false；HTTPS 部署必须 true
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/iphone-ding.sqlite
# 自建 Bark 服务须额外明确允许其公网域名
BARK_ALLOWED_HOSTS=api.day.app
